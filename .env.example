# Public site URL for this environment (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only "true" on production. Preview/staging stay noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Official contact details — leave blank until approved; blank values are not rendered.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=

# Lead delivery (server-only). Leads are emailed via the Resend HTTP API.
# Without these, development logs leads to the server console and production returns 503.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
